# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (optional — only needed when running against a live backend
# or the admin CMS). See supabase/README.md for the full setup.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Set to "true" to read public data from Supabase (`resources` /
# `waitlists`) instead of the bundled JSON. Requires the keys above.
VITE_USE_SUPABASE="false"

# Service role key — server-only. Used by scripts/importToSupabase.ts to
# bypass RLS for the one-off catalog import. NEVER ship this to the
# browser; do not expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""

# Netlify secret, production context only, including Functions scope.
# Rebuilds public pages after an explicit admin publication. Never expose to Vite.
RESOURCE_PUBLISH_BUILD_HOOK=""

# Privacy-limited analytics. This must be the public phc_ project token, never
# a phx_ personal API key. POSTHOG_API_KEY / POSTHOG_HOST are accepted as
# legacy aliases by vite.config.ts, but the VITE_ names are preferred.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Cloudflare Turnstile public site key. Put the matching SECRET only in
# Supabase Dashboard -> Authentication -> Bot and Abuse Protection.
VITE_TURNSTILE_SITE_KEY=""
