{
  "name": "housing-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run catalog:build",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run catalog:build",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:build": "tsx scripts/mergeCatalog.ts",
    "seed:generate": "tsx scripts/generateSeed.ts",
    "import:supabase": "tsx scripts/importToSupabase.ts",
    "import:waitlists": "tsx scripts/importWaitlistsCsv.ts",
    "import:resources": "tsx scripts/importResourcesCsv.ts",
    "verify:rls": "tsx scripts/verifyRls.ts"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
    "@supabase/supabase-js": "^2.105.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "posthog-js": "^1.404.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
